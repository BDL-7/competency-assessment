artifacts/archive/**/brief/**/*.png
artifacts/archive/**/deck/renders/
artifacts/archive/2026-08-14-html-release/*.html

# Controlled/internal documents are not published to the public repository
docs/project/*.docx
docs/project/*.pdf
docs/controlled-sources/*.docx
docs/controlled-sources/*.pdf
scripts/documents/*.py

# Operational and governed workbooks require explicit data-owner approval
data/authoritative/*.xlsx
data/migration/*.xlsx
data/reference/*.xlsx

# Project-specific presentation content and notes require release approval
presentations/html-workshop/.workshop/
presentations/html-workshop/deck-content.js
presentations/html-workshop/speaker-notes.js
presentations/html-workshop/index.html
presentations/html-workshop/presenter.html

# Historical builders embed project-specific content; retain locally only
