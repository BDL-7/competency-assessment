# Configuration template for the future application.
# This repository does not yet contain a runnable Flask application, and these
# values are not currently consumed. Never put real credentials in this file.

APP_ENV=development
APP_BASE_URL=http://localhost:5000

# Local development should use a disposable database or an approved developer
# resource. Production secrets belong in Azure Key Vault.
DATABASE_URL=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_KEY_VAULT_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# The knowledge assistant is a separate read-only integration.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
