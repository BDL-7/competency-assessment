# Safe local-development reference values. Export them in the local shell;
# the application does not automatically load this file.
APP_ENV=development
APP_SECRET_KEY=replace-with-a-local-random-value
APP_MOCK_AUTH_ENABLED=false
APP_MOCK_USER_ID=SYN-USER-001
APP_MOCK_DISPLAY_NAME=Synthetic User
# Opt-in local read-only UI (requires mock identity and a dedicated SQLite file).
APP_PILOT_DEMO_ENABLED=false
APP_DATABASE_URL=sqlite:///instance/synthetic-pilot.db
